# Сначала: python3 scripts/configure.py --production --domain app.example.ru
# Отдельный сервер и отдельная БД. Не копируйте демобазу в production.
COMPOSE_PROJECT_NAME=dentflow-production
APP_ENV=production
POSTGRES_DB=dentflow_production
POSTGRES_USER=dentflow
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_64_HEX_CHARACTERS
SECRET_KEY=CHANGE_ME_GENERATE_64_HEX_CHARACTERS
ALLOWED_ORIGINS=https://app.example.ru
PUBLIC_URL=https://app.example.ru
COOKIE_SECURE=true
ENABLE_DEV_TOOLS=false
HTTP_PORT=8080
AI_PROVIDER=demo
AI_EXTERNAL_ENABLED=false
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5.1
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_B2B
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_CA_BUNDLE=
LOCAL_LLM_URL=http://llm:11434/v1
LOCAL_LLM_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CLINIC_SLUG=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ENABLED=false
REDIS_URL=redis://redis:6379/0
TZ=Europe/Moscow
