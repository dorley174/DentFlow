# Только локальная разработка. Не используйте эти значения для реальных данных.
COMPOSE_PROJECT_NAME=dentflow-development
APP_ENV=development
POSTGRES_DB=dentflow_dev
POSTGRES_USER=dentflow
POSTGRES_PASSWORD=Local-Demo-Database-2026
SECRET_KEY=local-development-secret-change-with-setup-script-2026
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
PUBLIC_URL=http://localhost:8081
COOKIE_SECURE=false
ENABLE_DEV_TOOLS=true
HTTP_PORT=8081
AI_PROVIDER=demo
AI_EXTERNAL_ENABLED=false
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5.1
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_B2B
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_CA_BUNDLE=
LOCAL_LLM_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CLINIC_SLUG=smile-avenue
TELEGRAM_BOT_USERNAME=
TELEGRAM_ENABLED=false
REDIS_URL=redis://redis:6379/0
TZ=Europe/Moscow
